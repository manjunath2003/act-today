# Optional. Without ANTHROPIC_API_KEY the pipeline falls back to a rule-based analyser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional news search (https://tavily.com). Without it, only the company's own pages are read.
TAVILY_API_KEY=
# Optional. Default is local SQLite file intel.db. For Postgres: postgresql://user:pass@host:5432/db
DATABASE_URL=
